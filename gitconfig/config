# vim: set filetype=gitconfig :

[user]
	name = sohamch08
	email = sohamchatterjee999@gmail.com
	signingkey = sohamchatterjee999@gmail.com
[init]
	defaultBranch = main
[core]
	pager = delta
	editor = nvim
	whitespace = error
	preloadindex = true
[interactive]
	diffFilter = delta --color-only
[include]
	path = ~/.config/delta/themes.gitconfig
[delta]
	navigate = true
	dark = true
	features = mellow-barbet
[merge]
	conflictStyle = zdiff3
[color "decorate"]
	HEAD = red
	branch = blue
	tag = yellow
	remoteBranch = magenta
[color "branch"]
	current = magenta
	local = default
	remote = yellow
	upstream = green
	plain = blue
[commit]
	gpgsign = true
	verbose = true
[status]
	branch = true
	showStash = true
	showUntrackedFiles = all
[branch]
	sort = -committerdate
[diff]
	algorithm = histogram
	colorMoved = default
	mnemonicPrefix = true
	renames = copies
[tag]
	gpgsign = true
[push]
	autoSetupRemote = true
	default = current
[pull]
	default = current
	rebase = true
[log]
	abbrevCommit = true
	graphColors = blue,yellow,cyan,magenta,green,red
[url "git@github.com:sohamch08/"]
	insteadOf = "ghsc:"
[url "git@github.com:"]
	insteadOf = "gh:"
[alias]
	l = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --all
	ss = status --short --branch
	ls = log --pretty=format:'%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]' --decorate --numstat
	unstage = restore --staged
	ca = !git add -A && git commit -av
	setup = !git init && git add . && git commit -m \"Init repo\"
	list-aliases = "!{ printf \"[alias]\\n\"; git config --get-regexp \"^alias\\\\.\" | sed -E \"s/^alias\\\\.([^ ]+) (.*)$/    \\\\1 = \\\\2/\"; } | bat --language=gitconfig --color=always --paging=never"
	list-aliases-global = "!{ printf \"[alias]\\n\"; git config --global --get-regexp \"^alias\\\\.\" | sed -E \"s/^alias\\\\.([^ ]+) (.*)$/    \\\\1 = \\\\2/\"; } | bat --language=gitconfig --color=always --paging=never"
	list-aliases-local = "!{ printf \"[alias]\\n\"; git config --local --get-regexp \"^alias\\\\.\" | sed -E \"s/^alias\\\\.([^ ]+) (.*)$/    \\\\1 = \\\\2/\"; } | bat --language=gitconfig --color=always --paging=never"
	undo = reset --soft HEAD^
	license = "!gh repo license view MIT > LICENSE && git add LICENSE && git commit -m \"ADD MIT LICENSE\" && git push"
