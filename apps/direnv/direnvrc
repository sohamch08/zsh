# Activate an existing uv virtual environment without creating one.
layout_uv() {
  local venv="$PWD/.venv"

  if [[ ! -d "$venv/bin" ]]; then
    log_status "No existing .venv found; skipping activation."
    return 0
  fi

  export VIRTUAL_ENV="$venv"
  PATH_add "$VIRTUAL_ENV/bin"
  export UV_ACTIVE=1
}
