# Activate an existing uv-style environment. Never create or sync one.
layout_uv() {
  local venv="$PWD/.venv"
  watch_file "$venv/pyvenv.cfg" "$venv/bin/python"
  if [[ ! -f "$venv/pyvenv.cfg" || ! -x "$venv/bin/python" ]]; then
    log_status "No usable .venv found; leaving the environment unchanged."
    return 0
  fi
  unset PYTHONHOME
  export VIRTUAL_ENV="$venv"
  PATH_add "$VIRTUAL_ENV/bin"
}
